# Copy to <port root>/.env and fill in. `.env` never goes into a commit.
#
# None of these has a default, deliberately: a default naming one infobase would make the
# toolkit quietly read or write that infobase whenever a variable was forgotten.

# DF1C_ROOT and DF1C_PROJECT are exported in the shell, not set here: this file is found
# through DF1C_ROOT (<root>/.env), so it cannot say where the root is.

# The infobase, read-only: a server infobase on MS SQL (with DF1C_USER empty, Windows
# authentication is used) ...
DF1C_SERVER=
DF1C_DB=
DF1C_USER=
DF1C_PASS=
# ... or a file infobase: the 1Cv8.1CD, or the folder holding it. Set this or the four above.
# Point it at a copy, or close the infobase first.
DF1C_FILE=

# The dForge tenant and its Postgres, for loading and checks
DF_TENANT=
DF_PG_HOST=localhost
DF_PG_PORT=
DF_PG_USER=
DF_PG_PASS=

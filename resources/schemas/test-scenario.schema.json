{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "dForge Module Test Scenarios",
	"description": "Scenarios for a dForge module (tests/*.test.json), run by `dforge-cli module test`. Covers the v0 subset described in docs/modules/module-tests.md: given / do / expect over the API as the signed-in user.",
	"type": "object",
	"required": ["describe", "tests"],
	"additionalProperties": false,
	"properties": {
		"$comment": { "type": "string" },
		"describe": { "type": "string", "description": "Name of the suite." },
		"fixture": { "type": "string", "description": "Named fixture from tests/test.json. Not read by v0: the workspace must already hold the data the scenarios rely on." },
		"isolation": { "enum": ["rollback", "clone"], "description": "Not used by v0: tests commit and leave their records behind." },
		"tests": { "type": "array", "items": { "$ref": "#/$defs/test" } }
	},
	"$defs": {
		"test": {
			"type": "object",
			"required": ["name"],
			"additionalProperties": false,
			"properties": {
				"$comment": { "type": "string" },
				"name": { "type": "string" },
				"as": { "const": "admin", "description": "v0 runs as the signed-in user; other fixture users are not supported yet." },
				"given": { "type": "array", "items": { "$ref": "#/$defs/givenBlock" } },
				"do": { "type": "array", "items": { "$ref": "#/$defs/step" } },
				"expect": { "type": "array", "items": { "$ref": "#/$defs/expectation" } }
			}
		},
		"givenBlock": {
			"type": "object",
			"required": ["entityCode", "records"],
			"additionalProperties": false,
			"properties": {
				"entityCode": { "type": "string" },
				"records": { "type": "array", "items": { "$ref": "#/$defs/values" } }
			}
		},
		"values": {
			"type": "object",
			"description": "Column values. A string \"$name.column\" reads a column of a record named earlier with \"$as\". \"$as\" names the record being created.",
			"properties": { "$as": { "type": "string" } }
		},
		"name": { "type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$" },
		"recordRef": {
			"description": "\"$name\" (a record named with \"$as\"), or { \"<entity>\": { \"<column>\": <value>, … } } matching exactly one record.",
			"oneOf": [
				{ "$ref": "#/$defs/name" },
				{
					"type": "object",
					"minProperties": 1,
					"maxProperties": 1,
					"additionalProperties": { "type": "object", "minProperties": 1 }
				}
			]
		},
		"step": {
			"oneOf": [
				{
					"type": "object",
					"required": ["insert"],
					"additionalProperties": false,
					"properties": {
						"insert": { "type": "string", "description": "Entity code." },
						"values": { "$ref": "#/$defs/values" },
						"$as": { "type": "string" }
					}
				},
				{
					"type": "object",
					"required": ["update", "values"],
					"additionalProperties": false,
					"properties": {
						"update": { "$ref": "#/$defs/recordRef" },
						"values": { "$ref": "#/$defs/values" }
					}
				},
				{
					"type": "object",
					"required": ["delete"],
					"additionalProperties": false,
					"properties": { "delete": { "$ref": "#/$defs/recordRef" } }
				},
				{
					"type": "object",
					"required": ["action"],
					"oneOf": [{ "required": ["record"] }, { "required": ["records"] }],
					"additionalProperties": false,
					"properties": {
						"action": { "type": "string", "description": "action_cd." },
						"record": { "$ref": "#/$defs/recordRef" },
						"records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recordRef" } },
						"params": { "type": "object" }
					}
				}
			]
		},
		"expectation": {
			"oneOf": [
				{
					"type": "object",
					"required": ["record", "equals"],
					"additionalProperties": false,
					"properties": {
						"record": { "$ref": "#/$defs/recordRef" },
						"equals": { "type": "object", "minProperties": 1 },
						"precision": { "type": "integer", "minimum": 0, "description": "Decimals numbers are compared at." }
					}
				},
				{
					"type": "object",
					"required": ["count", "equals"],
					"additionalProperties": false,
					"properties": {
						"count": { "type": "string", "description": "Entity code." },
						"where": { "type": "object", "description": "Canonical { c, o, v } / { g, i } filter." },
						"equals": { "type": "integer", "minimum": 0 }
					}
				},
				{
					"type": "object",
					"required": ["error"],
					"additionalProperties": false,
					"properties": {
						"error": {
							"type": "object",
							"minProperties": 1,
							"additionalProperties": false,
							"properties": {
								"code": { "type": "string" },
								"contains": { "type": "string" }
							}
						}
					}
				},
				{
					"type": "object",
					"required": ["refused"],
					"additionalProperties": false,
					"properties": { "refused": { "const": "canExecute" } }
				}
			]
		}
	}
}

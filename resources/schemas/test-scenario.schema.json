{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "dForge Module Test Scenarios",
	"description": "Scenarios for a dForge module (tests/*.test.json), run by `dforge-cli module test`. Covers the v0 subset described in docs/modules/module-tests.md: given / do / expect over the API as the signed-in user. A suite has no fixture or isolation yet: the workspace must already hold the data the scenarios rely on.",
	"type": "object",
	"required": ["describe", "tests"],
	"additionalProperties": false,
	"properties": {
		"$comment": { "type": "string" },
		"describe": { "type": "string", "description": "Name of the suite." },
		"tests": { "type": "array", "items": { "$ref": "#/$defs/test" } }
	},
	"$defs": {
		"test": {
			"type": "object",
			"required": ["name"],
			"additionalProperties": false,
			"properties": {
				"$comment": { "type": "string" },
				"name": { "type": "string" },
				"as": { "const": "admin", "description": "v0 runs as the signed-in user; other fixture users are not supported yet." },
				"given": { "type": "array", "items": { "$ref": "#/$defs/givenBlock" } },
				"do": { "type": "array", "items": { "$ref": "#/$defs/step" } },
				"expect": { "type": "array", "items": { "$ref": "#/$defs/expectation" } }
			}
		},
		"givenBlock": {
			"oneOf": [
				{
					"type": "object",
					"required": ["entityCode", "records"],
					"additionalProperties": false,
					"properties": {
						"entityCode": { "type": "string" },
						"records": { "type": "array", "items": { "$ref": "#/$defs/values" } }
					}
				},
				{
					"type": "object",
					"required": ["sql"],
					"additionalProperties": false,
					"description": "SQL that sets up what records cannot; it commits what it writes.",
					"properties": { "sql": { "$ref": "#/$defs/sql" } }
				}
			]
		},
		"sql": {
			"description": "SQL run through test.sql, only in the test's temporary workspace (not with --shared): a string, or an array of lines. Bare table names are the module's under test. For what the API cannot show.",
			"oneOf": [
				{ "type": "string", "minLength": 1 },
				{ "type": "array", "minItems": 1, "items": { "type": "string" } }
			]
		},
		"values": {
			"type": "object",
			"description": "Column values. A string \"$name.column\" reads a column of a record named earlier with \"$as\". \"$as\" names the record being created.",
			"properties": { "$as": { "type": "string" } }
		},
		"name": { "type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$" },
		"recordRef": {
			"description": "\"$name\" (a record named with \"$as\"), or { \"<entity>\": { \"<column>\": <value>, … } } matching exactly one record.",
			"oneOf": [
				{ "$ref": "#/$defs/name" },
				{
					"type": "object",
					"minProperties": 1,
					"maxProperties": 1,
					"additionalProperties": { "type": "object", "minProperties": 1 }
				}
			]
		},
		"addedAs": {
			"type": "object",
			"minProperties": 1,
			"description": "{ \"<name>\": \"<entity>\" }: names the one record of each entity the step added (an action's insert(), or a synchronous `async: false` trigger's). The step fails the test unless exactly one was added.",
			"propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
			"additionalProperties": { "type": "string" }
		},
		"step": {
			"oneOf": [
				{
					"type": "object",
					"required": ["insert"],
					"additionalProperties": false,
					"properties": {
						"insert": { "type": "string", "description": "Entity code." },
						"values": { "$ref": "#/$defs/values" },
						"$as": { "type": "string" }
					}
				},
				{
					"type": "object",
					"required": ["update", "values"],
					"additionalProperties": false,
					"properties": {
						"update": { "$ref": "#/$defs/recordRef" },
						"values": { "$ref": "#/$defs/values" },
						"$as": { "$ref": "#/$defs/addedAs" }
					}
				},
				{
					"type": "object",
					"required": ["delete"],
					"additionalProperties": false,
					"properties": {
						"delete": { "$ref": "#/$defs/recordRef" },
						"$as": { "$ref": "#/$defs/addedAs" }
					}
				},
				{
					"type": "object",
					"required": ["action"],
					"oneOf": [{ "required": ["record"] }, { "required": ["records"] }],
					"additionalProperties": false,
					"properties": {
						"action": { "type": "string", "description": "action_cd." },
						"record": { "$ref": "#/$defs/recordRef" },
						"records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recordRef" } },
						"params": { "type": "object" },
						"$as": { "$ref": "#/$defs/addedAs" }
					}
				}
			]
		},
		"expectation": {
			"oneOf": [
				{
					"type": "object",
					"required": ["record", "equals"],
					"additionalProperties": false,
					"properties": {
						"record": { "$ref": "#/$defs/recordRef" },
						"equals": { "type": "object", "minProperties": 1 },
						"precision": { "type": "integer", "minimum": 0, "maximum": 28, "description": "Decimals numbers are compared at." }
					}
				},
				{
					"type": "object",
					"required": ["count", "equals"],
					"additionalProperties": false,
					"properties": {
						"count": { "type": "string", "description": "Entity code." },
						"where": { "type": "object", "description": "Canonical { c, o, v } / { g, i } filter." },
						"equals": { "type": "integer", "minimum": 0 }
					}
				},
				{
					"type": "object",
					"required": ["error"],
					"additionalProperties": false,
					"properties": {
						"error": {
							"type": "object",
							"minProperties": 1,
							"additionalProperties": false,
							"properties": {
								"code": { "type": "string" },
								"contains": { "type": "string" }
							}
						}
					}
				},
				{
					"type": "object",
					"required": ["refused"],
					"additionalProperties": false,
					"properties": { "refused": { "const": "canExecute" } }
				},
				{
					"type": "object",
					"required": ["query"],
					"allOf": [{ "$ref": "#/$defs/rows" }],
					"additionalProperties": false,
					"properties": {
						"query": {
							"type": "object",
							"required": ["entity"],
							"description": "A query.run query, read as the test's user: { entity, columns, filter, sort }. A column { \"c\", \"agg\" } aggregates (sum, count, avg, min, max) grouped by the columns with \"agg\": \"group\"; an aggregate is named by its column. At most 1000 rows.",
							"properties": {
								"entity": { "type": "string" },
								"columns": { "type": "array" },
								"filter": { "type": "object" },
								"sort": { "type": "array" }
							}
						},
						"equals": true, "contains": true, "rowCount": true, "precision": true
					}
				},
				{
					"type": "object",
					"required": ["register"],
					"allOf": [{ "$ref": "#/$defs/rows" }],
					"additionalProperties": false,
					"properties": {
						"register": {
							"type": "object",
							"required": ["name", "resource"],
							"description": "An accounting register's balances per account (query.runRegister), as a report's register dataset declares them: name, resource, interval, columns, filter, sort, rollup."
						},
						"params": { "type": "object", "description": "The values of the @params the register block names (an interval's from / to)." },
						"equals": true, "contains": true, "rowCount": true, "precision": true
					}
				},
				{
					"type": "object",
					"required": ["report"],
					"allOf": [{ "$ref": "#/$defs/rows" }],
					"additionalProperties": false,
					"properties": {
						"report": { "type": "string", "minLength": 1, "description": "The report's code: the module under test's (\"sales_funnel\"), or another module's (\"crm.sales_funnel\"). Run with report.run as the test's user." },
						"dataset": { "type": "string", "description": "The dataset whose rows are checked; required when the report has more than one." },
						"params": { "type": "object", "description": "The report's param values." },
						"equals": true, "contains": true, "rowCount": true, "precision": true
					}
				},
				{
					"type": "object",
					"required": ["sql"],
					"allOf": [{ "$ref": "#/$defs/rows" }],
					"additionalProperties": false,
					"properties": {
						"sql": { "$ref": "#/$defs/sql", "description": "Read-only: a check that writes is refused." },
						"equals": true, "contains": true, "rowCount": true, "precision": true
					}
				}
			]
		},
		"rows": {
			"description": "What rows to expect. equals: an array (exactly these rows, in order), an object (exactly one row) or a value (one row of one column); contains: rows each found among them; rowCount: how many. A row compares only the columns it names.",
			"anyOf": [{ "required": ["equals"] }, { "required": ["contains"] }, { "required": ["rowCount"] }],
			"properties": {
				"equals": true,
				"contains": { "type": "array", "items": { "type": "object" } },
				"rowCount": { "type": "integer", "minimum": 0 },
				"precision": { "type": "integer", "minimum": 0, "maximum": 28, "description": "Decimals numbers are compared at." }
			}
		}
	}
}

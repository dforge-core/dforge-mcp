{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://dforge.dev/schemas/menus.schema.json",
	"title": "dForge Menus",
	"description": "Menu definitions for a dForge module",
	"type": "object",
	"additionalProperties": {
		"$ref": "#/$defs/menu"
	},
	"$defs": {
		"menu": {
			"type": "object",
			"required": ["label", "items"],
			"properties": {
				"label": {
					"type": "string",
					"description": "Menu display name"
				},
				"description": {
					"type": "string",
					"description": "Optional description text (tooltip, subtitle)"
				},
				"folders": {
					"type": "array",
					"items": { "type": "string" },
					"description": "Flat folder codes this menu is linked to (module code for the root, module code + '_' + each nesting segment for children, e.g. 'logistics_all_trips'; the full path, the module-relative path, and a folder's own key when unique in the tree also resolve). Omit to link the menu to every folder the module declares. Scopes the folder-to-menu link only — every folder in ui/folders.json is created either way. A code matching no folder, or a key two branches share, fails the install."
				},
				"items": {
					"type": "object",
					"description": "Menu items keyed by item code",
					"additionalProperties": {
						"$ref": "#/$defs/menuItem"
					}
				}
			},
			"additionalProperties": false
		},
		"menuItem": {
			"type": "object",
			"required": ["label"],
			"properties": {
				"itemType": {
					"type": ["string", "null"],
					"enum": ["V", "D", "R", null],
					"description": "Item type: V=Data View, D=Document, R=Report, null=folder/section"
				},
				"dataViewCode": {
					"type": "string",
					"description": "Data view code (when itemType is 'V')"
				},
				"documentCode": {
					"type": "string",
					"description": "Document code (when itemType is 'D')"
				},
				"reportCode": {
					"type": "string",
					"description": "Report code (when itemType is 'R')"
				},
				"orderNum": {
					"type": "integer",
					"description": "Display order"
				},
				"label": {
					"type": "string",
					"description": "Menu item display text"
				},
				"description": {
					"type": "string",
					"description": "Optional description text (tooltip, subtitle)"
				},
				"icon": {
					"type": "string",
					"description": "Bootstrap icon name"
				},
				"children": {
					"type": "object",
					"description": "Child menu items (for folder/section items)",
					"additionalProperties": {
						"$ref": "#/$defs/menuItem"
					}
				}
			},
			"additionalProperties": false
		}
	}
}

{
	"name": "@dforge-core/dforge-mcp",
	"version": "0.2.14",
	"description": "MCP server for dForge module authoring. Exposes 34 scaffold/patch/validate/pack/install tools and schema resources so AI agents (Claude Code, Cursor, Zed) can create and ship dForge modules.",
	"license": "MIT",
	"homepage": "https://github.com/iash44/dForge-core",
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dforge-core/dforge-mcp.git"
	},
	"bin": {
		"dforge-mcp": "dist/server.js",
		"dforge-install-skills": "scripts/install-skills.mjs"
	},
	"files": [
		"dist/",
		"docs/",
		"resources/",
		"skills/",
		"scripts/install-skills.mjs",
		"README.md",
		"CHANGELOG.md"
	],
	"main": "dist/server.js",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup",
		"sync-schemas": "node scripts/vendor-schemas.cjs",
		"prepublishOnly": "node scripts/vendor-schemas.cjs && tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"install-skills": "node scripts/install-skills.mjs"
	},
	"dependencies": {
		"@dforge-core/dforge-cli": "^0.2.14",
		"@dforge-core/metadata": "^0.0.15",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
